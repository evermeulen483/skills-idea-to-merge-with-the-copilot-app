---
import Base from '../layouts/Base.astro';
import Bookmarks from '../components/Bookmarks.astro';
---
<Base title="Mona's Bookmark Manager App">
  <header>
    <p class="eyebrow">Good links deserve a home</p>
    <h1><span aria-hidden="true">🔖</span> Mona's Bookmark Manager App</h1>
    <p class="tagline">Keep your next great read, useful find, or tiny inspiration. One link, one little <code>mona-</code> alias — no account needed.</p>
  </header>

  <main>
    <Bookmarks />
  </main>

  <footer>
    <p>Your collection stays on this device, saved in your browser.</p>
    <p>Slugs are local labels, not shortened URLs. Links open the original page in a new tab.</p>
  </footer>
</Base>
